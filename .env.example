# Shared secret configured on the org webhook. openssl rand -hex 32
WEBHOOK_SECRET=

# This repository, as owner/name — where the review workflow lives.
WORKFLOW_REPO=

# Fine-grained PAT scoped to WORKFLOW_REPO only, Actions: write.
# Actions:write can start the workflow but cannot alter it.
# Leave unset to verify and log without dispatching anything.
DISPATCH_TOKEN=

# Branch to run the workflow from. Default: master (set to main if your fork uses it)
# WORKFLOW_REF=main

# Optional allowlist while rolling out. Unset means every repo in the org.
# REVIEW_REPOS=owner/repo-one,owner/repo-two

# Optional. Defaults to dependabot[bot],renovate[bot],github-actions[bot].
# If an automation account opens most of your PRs, do NOT list it here.
# SKIP_AUTHORS=

# Review pull requests opened from forks. Default false.
# The runner reads the branch while holding an org-wide pull-request-write
# token, and a fork author is outside your organisation. Enable only if you
# understand that.
# REVIEW_FORKS=false
